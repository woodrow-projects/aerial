# ── Aerial environment ───────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (see ADR D10).

# Public base URL used to construct listener/endpoint URLs (no trailing slash)
PUBLIC_BASE_URL=https://radio.example.com

# ── Control plane ─────────────────────────────────────────────────────────────
CONTROL_PLANE_PORT=3000
# URL Liquidsoap uses to reach the control plane's internal hooks
INTERNAL_API_URL=http://control-plane:3000
# Shared secret guarding the /internal/* hooks (auth, metadata, status).
# Generated per install; only the control plane and its generated Liquidsoap
# configs know it. Liquidsoap sends it as the x-internal-token header.
INTERNAL_API_TOKEN=change-me-internal-token
# At-rest encryption key for stored provider credentials (the CDN API key).
# REQUIRED to use the CDN toggle, >=32 chars:  openssl rand -hex 32
APP_SECRET=change-me-at-least-32-characters-long
# Where the built SPA assets live inside the control-plane image
WEB_DIST=/app/web

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=aerial
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=aerial
DATABASE_URL=postgresql://aerial:change-me-please@postgres:5432/aerial?schema=public

# ── Icecast ───────────────────────────────────────────────────────────────────
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin
ICECAST_ADMIN_USER=admin

# ── Audio engine ──────────────────────────────────────────────────────────────
LIQUIDSOAP_BIN=liquidsoap
# Shared volume where Liquidsoap writes HLS segments (served by Caddy / CDN origin)
HLS_ROOT=/srv/hls
# Per-channel fallback media directory (empty => silence via mksafe)
MEDIA_ROOT=/srv/media
# First harbor (DJ ingest) port; each channel gets HARBOR_BASE_PORT + index
HARBOR_BASE_PORT=8100

# ── TLS / Caddy ───────────────────────────────────────────────────────────────
# Domain Caddy issues a Let's Encrypt cert for. DJ ingest is TLS-terminated by Caddy,
# so a cert is required: use a real domain in production, or "localhost" for local dev
# (Caddy internal CA; DJ clients skip-verify). ":80" disables TLS and breaks ingest.
SITE_ADDRESS=radio.example.com
ACME_EMAIL=you@example.com

# ── Operator auth (better-auth) ───────────────────────────────────────────────
# Session signing secret — REQUIRED, >=32 chars:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# Lock public registration after seeding the first operator (true|false)
AUTH_DISABLE_SIGNUP=false
# Extra trusted origins (comma-separated). Only needed for the Vite dev proxy:
# AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Optional social login — set BOTH id+secret to enable a provider, and register
# the redirect URI <PUBLIC_BASE_URL>/api/auth/callback/<provider> with it.
# Also rebuild the SPA with VITE_GOOGLE_ENABLED=1 / VITE_GITHUB_ENABLED=1 to show the buttons.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# First-operator seed (used once by `pnpm seed:operator`, not at normal runtime):
# OPERATOR_EMAIL=you@example.com
# OPERATOR_PASSWORD=change-me-strong
# OPERATOR_NAME=Operator
