# Aerial control-plane image: the Liquidsoap 2.2.x engine (savonet, with ffmpeg
# support compiled in) plus Node — the API + SPA + supervisor that spawns one
# liquidsoap child process per channel (ADR D5/D6). Build context is the repo root.
FROM savonet/liquidsoap:v2.2.5

USER root
# Node 26 (matches the dev host). Needs require(ESM) for better-auth (ESM-only);
# the old 20.18 pin lacked it.
ENV NODE_VERSION=26.3.0

# Node from the official arch-aware tarball (NodeSource doesn't track Debian sid).
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl xz-utils ca-certificates libatomic1 \
 && rm -rf /var/lib/apt/lists/* \
 && ARCH="$(uname -m)" \
 && case "$ARCH" in \
      x86_64) NODEARCH=x64 ;; \
      aarch64) NODEARCH=arm64 ;; \
      *) echo "unsupported arch: $ARCH" && exit 1 ;; \
    esac \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODEARCH}.tar.xz" -o /tmp/node.tar.xz \
 && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
 && rm /tmp/node.tar.xz \
 # Install pnpm directly (avoid corepack: bundled keys in Node 20.18 fail pnpm signature verification).
 && npm install -g pnpm@9.12.0

WORKDIR /repo

# Install workspace deps (copy manifests first for layer caching).
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/shared/package.json packages/shared/
COPY apps/control-plane/package.json apps/control-plane/
# The Prisma schema must be present at install time: the control-plane
# `postinstall` runs `prisma generate`, which needs it. (node_modules is
# dockerignored, so the generated client survives the `COPY . .` below.)
COPY apps/control-plane/prisma apps/control-plane/prisma
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile || pnpm install

# Build shared lib, API and SPA. The Prisma client was already generated by the
# control-plane `postinstall` during install above.
COPY . .
RUN pnpm --filter @aerial/shared build \
 && pnpm --filter @aerial/control-plane build \
 && pnpm --filter @aerial/web build \
 && mkdir -p /app/web && cp -r apps/web/dist/* /app/web/

ENV NODE_ENV=production
ENV WEB_DIST=/app/web
ENV LIQUIDSOAP_BIN=/usr/bin/liquidsoap

# Run as the non-root 'liquidsoap' user (uid 10000) from the base image. Pre-own
# the runtime dirs so the named volumes inherit that ownership on first creation
# (fresh volumes required — a volume created under the old root setup won't be
# writable by this user).
RUN mkdir -p /srv/data /srv/hls /srv/media && chown -R 10000:10001 /srv
USER 10000:10001

WORKDIR /repo/apps/control-plane
EXPOSE 3000

# Reset the savonet base image's `liquidsoap` entrypoint so our CMD runs in a shell.
ENTRYPOINT []

# Apply DB migrations (ADR D11), then start.
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && node dist/main.js"]
