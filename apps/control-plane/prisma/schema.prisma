// Aerial control-plane data model (ADR D10/D11).
// Single-operator, multi-channel. Stream keys are stored hashed only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Operator accounts/sessions are owned by better-auth (User/Session/Account/
// Verification models below, generated by @better-auth/cli).

/// Which outputs a channel emits (ADR D2). `both` = HLS + Icecast.

enum DeliveryMode {
  hls
  icecast
  both
}

/// CDN providers Aerial can auto-provision (ADR D4 — Bunny-first, pluggable).

enum CdnProvider {
  bunny
}

/// One-toggle CDN lifecycle (SPEC §7.2): disabled → provisioning → active | error.

enum CdnStatus {
  disabled
  provisioning
  active
  error
}

/// Singleton CDN configuration (one per install). `apiKeyEnc` is the operator's
/// Bunny API key, AES-256-GCM encrypted at rest (NOT hashed — it must be replayable
/// to Bunny). `pullZoneId` is persisted before further config so a retried enable
/// resumes instead of creating a duplicate zone (idempotent state machine).

model CdnConfig {
  id           Int         @id @default(1) // singleton row (always id = 1)
  provider     CdnProvider @default(bunny)
  status       CdnStatus   @default(disabled)
  pullZoneId   String? // Bunny pull-zone id, kept across disable so embeds keep working
  cdnHostname  String? // <zone>.b-cdn.net
  apiKeyEnc    String? // AES-256-GCM ciphertext of the Bunny API key
  errorMessage String? // last provisioning error (when status = error)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

/// A broadcastable channel. slug doubles as the HLS path prefix and Icecast mount.

model Channel {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  mount          String       @unique // "/<slug>"
  isActive       Boolean      @default(true)
  deliveryMode   DeliveryMode @default(both)
  harborPort     Int          @unique // DJ ingest port (HARBOR_BASE_PORT + index)
  hlsBitrates    Int[]        @default([64, 128]) // kbps, HE-AAC + AAC-LC
  icecastBitrate Int          @default(128) // kbps MP3
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  streamKeys StreamKey[]
  sessions   StreamSession[]
}

/// Per-channel ingest credentials. Only the bcrypt hash is stored (D10).

model StreamKey {
  id         String    @id @default(uuid())
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  keyHash    String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([channelId])
}

/// Per-stream log for abuse/DMCA response and analytics (D10).

model StreamSession {
  id        String    @id @default(uuid())
  channelId String
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mount     String
  sourceIp  String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([channelId])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
