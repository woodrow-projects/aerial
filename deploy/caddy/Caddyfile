# Aerial edge — auto-TLS, HLS static origin, Icecast proxy, API/SPA proxy, and
# TLS-terminated DJ ingest (ADR D10/D11).
#
# SITE_ADDRESS=radio.example.com  → automatic Let's Encrypt HTTPS + ingest cert.
# SITE_ADDRESS=localhost          → Caddy internal CA (local dev; clients skip-verify).
{
	# ACME_EMAIL_DIRECTIVE is "email" when ACME_EMAIL is non-empty, "" otherwise
	# (compose ${ACME_EMAIL:+email}) — a bare `email` directive with no argument
	# is a parse error, so the whole line must vanish for no-TLS local installs.
	{$ACME_EMAIL_DIRECTIVE} {$ACME_EMAIL}

	# ── DJ ingest: terminate TLS for the Icecast source protocol, then proxy the
	# decrypted stream to the per-channel Liquidsoap harbor on the same port. The
	# harbors are internal-only; only Caddy is published. The `tls` handler reuses
	# the certs Caddy manages for {$SITE_ADDRESS} (matched by SNI). Static range
	# 8100–8110 maps to channel harbor ports (HARBOR_BASE_PORT + index).
	layer4 {
		:8100 {
			route {
				tls
				proxy control-plane:8100
			}
		}
		:8101 {
			route {
				tls
				proxy control-plane:8101
			}
		}
		:8102 {
			route {
				tls
				proxy control-plane:8102
			}
		}
		:8103 {
			route {
				tls
				proxy control-plane:8103
			}
		}
		:8104 {
			route {
				tls
				proxy control-plane:8104
			}
		}
		:8105 {
			route {
				tls
				proxy control-plane:8105
			}
		}
		:8106 {
			route {
				tls
				proxy control-plane:8106
			}
		}
		:8107 {
			route {
				tls
				proxy control-plane:8107
			}
		}
		:8108 {
			route {
				tls
				proxy control-plane:8108
			}
		}
		:8109 {
			route {
				tls
				proxy control-plane:8109
			}
		}
		:8110 {
			route {
				tls
				proxy control-plane:8110
			}
		}
	}
}

{$SITE_ADDRESS} {
	# ── HLS: segments + playlists + nowplaying.json (the CDN origin) ───────────
	handle_path /hls/* {
		root * /srv/hls
		file_server

		@m3u8 path *.m3u8
		header @m3u8 Cache-Control "no-cache"

		@nowplaying path */nowplaying.json
		header @nowplaying Cache-Control "public, max-age=3"

		@segments path *.ts *.m4s *.mp4
		header @segments Cache-Control "public, max-age=31536000, immutable"

		header Access-Control-Allow-Origin "*"
	}

	# ── Icecast low-latency / legacy mounts ────────────────────────────────────
	# ALLOW-LIST, not a passthrough. Only per-channel mount paths reach Icecast —
	# one kebab-case segment, matching the endpoint the control plane advertises
	# (`${origin}/icecast/<slug>`, channels.service.ts) and `slugSchema` in
	# packages/shared. Everything else under /icecast/* is Icecast's own web root
	# and admin surface — status.xsl, status-json.xsl and /admin/stats.xml serve
	# per-mount listener counts and now-playing metadata with NO authentication,
	# and `<fileserve>1</fileserve>` + the `<alias source="/">` in
	# engine/icecast/icecast.xml.template make them reachable. Forwarding the whole
	# URL space published all of it on every install.
	# Pinned by apps/control-plane/src/channels/caddy-icecast-matcher.spec.ts —
	# keep the pattern and slugSchema in step.
	@icecast_mount path_regexp ^/icecast/[a-z0-9]+(-[a-z0-9]+)*$
	handle @icecast_mount {
		uri strip_prefix /icecast
		reverse_proxy icecast:8000
	}

	# Icecast's status pages, admin actions and web root: never public.
	handle /icecast/* {
		respond 404
	}

	# ── Control-plane API + SPA ────────────────────────────────────────────────
	handle {
		reverse_proxy control-plane:3000
	}
}
