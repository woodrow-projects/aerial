# Aerial edge — auto-TLS, HLS static origin, Icecast proxy, API/SPA proxy.
# SITE_ADDRESS=radio.example.com  → automatic Let's Encrypt HTTPS.
# SITE_ADDRESS=:80                → plain HTTP for local/dev (no TLS).

{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	# ── HLS: segments + playlists + nowplaying.json (the CDN origin) ───────────
	handle_path /hls/* {
		root * /srv/hls
		file_server

		# Playlists must not be cached long; segments are immutable.
		@m3u8 path *.m3u8
		header @m3u8 Cache-Control "no-cache"

		@nowplaying path */nowplaying.json
		header @nowplaying Cache-Control "public, max-age=3"

		@segments path *.ts *.m4s *.mp4
		header @segments Cache-Control "public, max-age=31536000, immutable"

		# Allow embedding from operators' own sites (ADR D9).
		header Access-Control-Allow-Origin "*"
	}

	# ── Icecast low-latency / legacy mounts ────────────────────────────────────
	handle_path /icecast/* {
		reverse_proxy icecast:8000
	}

	# ── Control-plane API + SPA ────────────────────────────────────────────────
	handle {
		reverse_proxy control-plane:3000
	}
}
