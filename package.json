{
  "name": "aerial",
  "version": "0.0.0",
  "private": true,
  "description": "CDN-native, self-hosted online radio platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @aerial/control-plane prisma:generate",
    "db:migrate": "pnpm --filter @aerial/control-plane prisma:migrate"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
