# Rendered by make-formula.sh at release time; pushed to woodrow-projects/homebrew-tap
# (the tap lives in the org; release assets stay on the aerial repo's Releases).
class Aerial < Formula
  desc "Provision a self-hosted Aerial radio station anywhere"
  homepage "https://github.com/woodrow-projects/aerial"
  version "@@VERSION@@"

  on_macos do
    on_arm do
      url "https://github.com/woodrow-projects/aerial/releases/download/v@@VERSION@@/aerial-darwin-arm64.tar.gz"
      sha256 "@@SHA_DARWIN_ARM64@@"
    end
    on_intel do
      url "https://github.com/woodrow-projects/aerial/releases/download/v@@VERSION@@/aerial-darwin-x64.tar.gz"
      sha256 "@@SHA_DARWIN_X64@@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/woodrow-projects/aerial/releases/download/v@@VERSION@@/aerial-linux-arm64.tar.gz"
      sha256 "@@SHA_LINUX_ARM64@@"
    end
    on_intel do
      url "https://github.com/woodrow-projects/aerial/releases/download/v@@VERSION@@/aerial-linux-x64.tar.gz"
      sha256 "@@SHA_LINUX_X64@@"
    end
  end

  def install
    bin.install "aerial"
  end

  test do
    system bin/"aerial", "--version"
  end
end
