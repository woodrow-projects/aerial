{
  "name": "@aerial/cli",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "aerial — provision a self-hosted radio station anywhere",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile": "bun build --compile --minify src/index.ts --outfile dist-bin/aerial",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "2.1.9",
    "bun": "^1.2.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
